{
  "name": "sulemanji-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && npm run test:site-built && wrangler deploy --dry-run --config wrangler.site.jsonc && wrangler deploy --dry-run --config wrangler.site-staging.jsonc",
    "dev:site": "wrangler dev --config wrangler.site.jsonc",
    "dev:site:staging": "wrangler dev --config wrangler.site-staging.jsonc",
    "test:site-built": "node scripts/test-site-built.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261125.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  },
  "dependencies": {
    "marked": "18.3.0",
    "parse5": "8.0.1"
  }
}
