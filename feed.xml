---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" />
  <link href="{{ '/writing' | absolute_url }}" />
  {% if site.data.writing_discovery.updated_on %}<updated>{{ site.data.writing_discovery.updated_on | date: "%Y-%m-%dT00:00:00Z" }}</updated>{% endif %}
  {% for article in site.data.writing_discovery.articles %}
  <entry>
    <title>{{ article.title | xml_escape }}</title>
    <id>{{ article.url | absolute_url }}</id>
    <link href="{{ article.url | absolute_url }}" />
    <published>{{ article.published_on | date: "%Y-%m-%dT00:00:00Z" }}</published>
    <updated>{{ article.updated_on | default: article.published_on | date: "%Y-%m-%dT00:00:00Z" }}</updated>
    <summary>{{ article.description | xml_escape }}</summary>
    <author><name>{{ site.person.name | xml_escape }}</name></author>
  </entry>
  {% endfor %}
</feed>
