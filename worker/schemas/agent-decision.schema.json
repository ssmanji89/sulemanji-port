{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "topic", "message"],
      "properties": {
        "kind": { "const": "question" },
        "topic": { "type": "string", "minLength": 2 },
        "message": { "type": "string", "minLength": 10 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "const": "checkpoint" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "knownFacts", "openQuestions"],
          "properties": {
            "summary": { "type": "string", "minLength": 20 },
            "knownFacts": { "type": "array", "items": { "type": "string" } },
            "openQuestions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "blueprint"],
      "properties": {
        "kind": { "const": "blueprint" },
        "blueprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "workflow",
            "automationOpportunities",
            "sessionAgenda",
            "recommendedSessionLengthMinutes"
          ],
          "properties": {
            "summary": { "type": "string", "minLength": 10 },
            "workflow": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "automationOpportunities": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "sessionAgenda": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "recommendedSessionLengthMinutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reasons"],
      "properties": {
        "kind": { "const": "hold" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "draft": { "type": "string" }
      }
    }
  ]
}
